{
  "cleanUrls": true,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.bydigitallab.ru" }], "destination": "https://bydigitallab.ru/$1", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(favicon.*|apple-touch-icon.png|logo.png|og-image.jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
